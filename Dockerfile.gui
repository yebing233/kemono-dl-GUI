# kemono-dl GUI — web interface, no desktop required.
#
#   docker build -f Dockerfile.gui -t kemono-dl-gui .
#   docker run --rm -p 127.0.0.1:8765:8765 \
#     -v "$PWD/downloads:/downloads" -v kemono-gui-data:/data \
#     -e KEMONO_DL_GUI_PASSWORD=change-me kemono-dl-gui
#
# Then open http://127.0.0.1:8765/ in a browser.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    KEMONO_DL_GUI_DATA=/data \
    KEMONO_DL_GUI_HISTORY_DIR=/data \
    KEMONO_DL_GUI_DOWNLOAD_DIR=/downloads \
    KEMONO_DL_GUI_HOST=0.0.0.0 \
    KEMONO_DL_GUI_PORT=8765 \
    KEMONO_DL_GUI_NO_BROWSER=1

WORKDIR /app

# Only what the GUI needs: the downloader, the web layer and its static assets.
COPY pyproject.toml README.md ./
COPY kemono_dl/ ./kemono_dl/
COPY kemono_dl_gui/ ./kemono_dl_gui/

RUN pip install --no-cache-dir . \
    && useradd --create-home --uid 10001 kemono \
    && mkdir -p /downloads /data \
    && chown -R kemono:kemono /downloads /data /app

USER kemono

VOLUME ["/downloads", "/data"]
EXPOSE 8765

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8765/healthz', timeout=4).status == 200 else 1)"

# Environment variables above already supply host/port/no-browser defaults.
CMD ["python", "-m", "kemono_dl_gui"]
